# Salin ke .env lalu isi. Jangan commit .env.
NODE_ENV=production
PORT=3000
APP_URL=https://domain-anda.example
TRUST_PROXY=1
BIND_HOST=0.0.0.0
TRUSTED_PROXY_IPS=
BEHIND_CLOUDFLARE=false
ALLOWED_HOSTS=

# Database (MySQL/MariaDB)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_POOL=8
DB_SSL=false
DB_SSL_VERIFY=
DB_SSL_CA=

# Rahasia: jalankan `npm run gen-secrets`. Simpan DATA_KEY baik-baik.
SESSION_SECRET=
DATA_KEY=

# Premku API
PREMKU_BASE=https://premku.com/api
PREMKU_API_KEY=
PREMKU_API_SECRET=
IMAGE_HOSTS=cdn.premku.com
ORDER_TTL_MIN=5

# Email (opsional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Login Google & Turnstile (opsional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_REQUIRE_2FA=false
ADMIN_ALLOWED_IPS=

# Log
LOG_FORMAT=pretty
LOG_COLOR=true
LOG_STATIC=false
